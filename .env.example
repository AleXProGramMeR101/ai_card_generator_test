# Адрес OpenAI-совместимого API (Groq, OpenAI, Ollama, vLLM)
LLM_BASE_URL=https://api.somellm.com/openai/v1

# Ключ API; для локальной модели можно оставить пустым
LLM_API_KEY=your_api_key_here

# Название модели у провайдера
LLM_MODEL=openai/gpt-oss-120b

# Глубина рассуждений для reasoning-моделей: low / medium / high; пусто - не передавать
LLM_REASONING_EFFORT=low

# Просить ответ строго в JSON; false, если модель это не поддерживает
LLM_JSON_MODE=true

# Разброс формулировок: 0 - сухо и одинаково, выше - разнообразнее
LLM_TEMPERATURE=0.4

# Максимум токенов в ответе; 0 - не передавать
LLM_MAX_TOKENS=4000

# Сколько секунд ждать ответа модели
LLM_TIMEOUT=90

# Повторы при сетевых ошибках и лимитах провайдера
LLM_MAX_RETRIES=3

# Сколько раз просить модель исправить ответ, не прошедший проверки
REPAIR_ATTEMPTS=1

# Сколько символов текста одного товара можно отправить в модель
MAX_PRODUCT_CHARS=20000

# Адрес и порт веб-интерфейса; на сервере без прокси - WEB_HOST=0.0.0.0
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Предельный размер загружаемого файла, МБ
WEB_MAX_UPLOAD_MB=50

# Сколько товаров обрабатывается из одного файла
WEB_MAX_PRODUCTS=10

# Генераций в минуту с одного адреса; 0 - без ограничения
WEB_RATE_LIMIT_PER_MINUTE=20
